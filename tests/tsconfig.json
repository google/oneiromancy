{
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "rootDir": "..",
    "strict": true,
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "paths": {
      "@core/*": ["../core/*"],
      "@/lib/*": ["../core/lib/*", "../lib/*"],
      "@/types/*": ["../core/types/*", "../types/*"],
      "@/*": ["../*"],
      "*": ["../../node_modules/*"]
    },
    "typeRoots": [
      "../node_modules/@types"
    ]
  },
  "include": [
    "../tailwind.config.ts",
    "../app/page.tsx",
    "../core/lib/**/*.ts",
    "../core/types/**/*.ts",
    "../lib/**/*.ts",
    "../components/**/*.tsx",
    "../context/**/*.tsx",
    "../types/**/*.ts",
    "./helpers/ambient.d.ts"
  ]
}
